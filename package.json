{
  "name": "axon-pi",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Axon — 多子 Agent 协作桌面客户端",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "trustedDependencies": [
    "electron",
    "electron-builder",
    "esbuild"
  ],
  "scripts": {
    "guard": "bun run scripts/check-bun-only.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/desktop/tsconfig.renderer.json",
    "test": "vitest run",
    "check": "bun run guard && bun run typecheck && bun run test && bun run build:desktop && bun run verify-lazy",
    "example:single": "bun run examples/single-agent.ts",
    "build:desktop": "bun run apps/desktop/scripts/build.mjs",
    "dev": "bun run build:desktop && env -u ELECTRON_RUN_AS_NODE electron apps/desktop/dist/main.mjs",
    "verify-lazy": "bun run scripts/verify-lazy-loading.mjs",
    "ui-smoke": "bun run build:desktop && bun scripts/ui-smoke.mjs",
    "example:real": "bun run examples/real-model-spike.ts",
    "example:orchestration": "bun run examples/real-orchestration-spike.ts",
    "example:dialect": "bun run examples/real-dialect-spike.ts",
    "build:pack": "bun run build:desktop && bun run scripts/pack.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@types/node": "22.10.2",
    "@types/react": "19",
    "@types/react-dom": "19",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "esbuild": "0.24.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "dependencies": {
    "react": "19",
    "react-dom": "19"
  }
}

# Electron 二进制走国内镜像。
# 注意：bun 只认 .npmrc 里 registry/scope/auth 几个键，自定义键不会转成 npm_config_*
# 传给依赖的 postinstall，所以 electron_mirror 必须写在 .env 里（bun install 会加载）。
ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/
ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/
